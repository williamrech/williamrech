rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('admin', false) == true;
    }
    function changed() {
      return request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys();
    }

    // Each device saves its own push token. Only the Cloud Functions read the list.
    match /devices/{token} {
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Profiles: the family can see names; you edit only your own name, gender and
    // quiet hours and name style. admin / mutes are written by the functions.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && changed().hasOnly(['name', 'gender', 'quiet', 'style', 'palette', 'hidden', 'skipDays', 'updatedAt'])
        && (!('style' in request.resource.data) || request.resource.data.style is map)
        && (!('name' in request.resource.data) ||
            (request.resource.data.name is string && request.resource.data.name.size() > 0
             && request.resource.data.name.size() <= 40))
        && (!('gender' in request.resource.data) || request.resource.data.gender in ['m', 'f']);
    }

    // Chamados (templates) are personal: only the owner sees and edits them.
    // mutedBy / lastFiredKey / lastManualAt are written by the functions.
    match /templates/{id} {
      allow read, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
        && !('mutedBy' in request.resource.data) && !('lastFiredKey' in request.resource.data)
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && changed().hasOnly(['emoji', 'title', 'body', 'answerType', 'options', 'recipients',
             'visibility', 'allowMute', 'nagEveryMin', 'durationHours', 'schedule', 'favorite', 'updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80;
    }

    // Fun content, palettes, occasions: public; edited by admins (Admin tab) or in the console.
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Drawings uploaded from the Admin tab (SVG text). Public, admins write.
    match /decor/{name} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.svg is string
        && request.resource.data.svg.size() < 60000
        && name.matches('^[a-z0-9-]+[.]svg$');
      allow delete: if isAdmin();
    }

    // Rounds: visible to the people involved; written only through the functions.
    match /rounds/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
    }
  }
}
